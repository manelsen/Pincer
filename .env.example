# Channels
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_token_here
LINE_CHANNEL_SECRET=your_line_secret_here
FEISHU_APP_ID=your_feishu_app_id_here
FEISHU_APP_SECRET=your_feishu_app_secret_here
DINGTALK_CLIENT_ID=your_dingtalk_client_id_here
DINGTALK_CLIENT_SECRET=your_dingtalk_client_secret_here
PINCER_WEBHOOK_TOKEN=your_webhook_token_here

# LLM Providers (set the keys for providers you plan to use)
GOOGLE_API_KEY=your_google_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENCODE_ZEN_API_KEY=your_opencode_zen_api_key_here
Z_AI_API_KEY=your_z_ai_api_key_here
Z_AI_CODING_API_KEY=your_z_ai_coding_api_key_here
MOONSHOT_API_KEY=your_moonshot_api_key_here
MOONSHOT_CODING_API_KEY=your_moonshot_coding_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MINIMAX_API_KEY=your_minimax_api_key_here

# MCP/Tools
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here

# Database overrides (optional — defaults from config.yaml)
# PINCER_DB_HOST=localhost
# PINCER_DB_PORT=5432
# PINCER_DB_USER=postgres
# PINCER_DB_PASSWORD=postgres
# PINCER_DB_NAME=pincer
# PINCER_DB_POOL_SIZE=10
# PINCER_DB_SSL=false
