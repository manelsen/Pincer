{
  "title": "Pincer — AI Agent Platform",
  "uid": "pincer-main",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "LLM Request Rate",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "rate(pincer_llm_request_count_total[1m])", "legendFormat": "{{provider}} / {{model}}"}]
    },
    {
      "id": 2,
      "title": "LLM Latency p95 (ms)",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.95, rate(pincer_llm_request_duration_milliseconds_bucket[5m]))", "legendFormat": "p95 {{provider}}"}]
    },
    {
      "id": 3,
      "title": "Tokens Consumed / min",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(pincer_llm_tokens_prompt_total_total[1m])", "legendFormat": "prompt {{provider}}"},
        {"expr": "rate(pincer_llm_tokens_completion_total_total[1m])", "legendFormat": "completion {{provider}}"}
      ]
    },
    {
      "id": 4,
      "title": "LLM Error Rate",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [{"expr": "rate(pincer_llm_error_count_total[1m])", "legendFormat": "{{provider}} — {{error_class}}"}]
    },
    {
      "id": 5,
      "title": "Channel Messages Received / min",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [{"expr": "rate(pincer_channel_message_received_count_total[1m])", "legendFormat": "{{channel_type}}"}]
    },
    {
      "id": 6,
      "title": "Channel Response Latency p95 (ms)",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.95, rate(pincer_channel_response_duration_milliseconds_bucket[5m]))", "legendFormat": "p95 {{channel_type}}"}]
    }
  ],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {}
}
